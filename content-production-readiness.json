  "launch_gate": "Money Factory business must be launch_ready or later, validation passed, verified gross margin >=20%, research verified, legal checked, and fulfillment feasible.",
  "product_demo_skill": {
    "id": "product-demo-short-form",
    "canvas": "9:16 portrait",
    "target_duration_seconds": [
      15,
      45
    ],
    "sequence": [
      "hook",
      "problem",
      "product_reveal",
      "demonstration",
      "proof",
      "objection_handler",
      "cta",
      "loop_or_payoff"
    ],
    "beat_cadence_seconds": [
      1.5,
      4
    ],
    "variants": [
      "entertainment_first",
      "direct_response",
      "build_in_public",
      "trend_product"
    ],
    "qa": [
      "product visible",
      "problem clear",
      "demo understandable without audio",
      "claim evidence attached",
      "no overlap/clipping",
      "native 9:16",
      "CTA phase-compliant",
      "audio/SFX separate from narration"
    ]
  }
