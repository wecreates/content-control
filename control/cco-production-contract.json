{
  "schema_version": 1,
  "name": "CCO production contract",
  "publication_enabled": false,
  "first_video_publish": false,
  "formats": {
    "shorts": {
      "canvas": [
        1080,
        1920
      ],
      "aspect": "9:16"
    },
    "long_form": {
      "canvas": [
        1920,
        1080
      ],
      "aspect": "16:9"
    }
  },
  "required_agents": [
    "research_trend_agent",
    "script_retention_agent",
    "visual_layout_director",
    "seo_publishing_agent",
    "character_continuity_director",
    "reference_decomposition_agent",
    "autonomous_viral_content_engine",
    "lead_comedy_retention_engineer",
    "chat_drop_clone_director",
    "style_memory_agent",
    "reference_selector_agent",
    "clone_repair_director",
    "story_room_director",
    "storyboard_director",
    "animatic_editor",
    "visual_development_director",
    "rigging_animation_director",
    "cinematography_director",
    "simulation_fx_director",
    "lighting_color_director",
    "editorial_director",
    "sound_music_director",
    "dialogue_performance_director",
    "continuity_asset_director",
    "production_manager_agent",
    "synthetic_audience_director",
    "ab_development_director",
    "accessibility_localization_director",
    "analytics_learning_agent",
    "rd_quarantine_agent",
    "premium_voice_director"
  ],
  "output_schema": {
    "video_metadata": {
      "target_format": "",
      "primary_high_cpm_keywords": [],
      "optimized_title": "",
      "seo_description": "",
      "tags": ""
    },
    "audio_narration": {
      "voice_profile": "",
      "full_voiceover_script": ""
    },
    "timeline_blueprint": [
      {
        "timestamp_start": "0.0",
        "timestamp_end": "5.0",
        "voiceover_chunk": "",
        "sound_effect_cue": "",
        "layout_layers": {
          "layer_0_background": "",
          "layer_1_static_props": "",
          "layer_2_characters": "",
          "layer_3_dynamic_props": "",
          "layer_4_on_screen_text": ""
        }
      }
    ]
  },
  "layout": {
    "safe_inset_pct": 5,
    "minimum_gap_px_short": 48,
    "minimum_gap_px_long": 64,
    "anti_overlap": true,
    "intentional_contact_requires_flag": true,
    "card_text_policy": "geometric/minimal only",
    "reference_style": {
      "background": "#FFFFFF",
      "stick": "#111111",
      "decorative_ui": "forbidden_by_default"
    }
  },
  "retention": {
    "hook_end_sec": 5,
    "setup_end_sec": 30,
    "pattern_interrupt_max_sec": 5,
    "invisible_cta_final_sec": 5
  },
  "done_gate": [
    "research evidence exists",
    "reference decomposition contains real AV evidence and transferable mechanics",
    "script retention gate passes",
    "creative blueprint validator passes",
    "character continuity gate passes",
    "layout collision test passes",
    "rendered proof visually reviewed",
    "audio channels verified separate",
    "reference parity review passes",
    "SEO package generated",
    "publication remains locked",
    "five-concept selection receipt exists before production",
    "character board lock hash passes",
    "voice assignment lock passes for speaking characters",
    "rendered clone parity is measured against source reference",
    "cross-reference style memory updated",
    "targeted repair plan exists for failed clone proof",
    "canonical CCSD validates",
    "story room receipt contains at least ten pitches",
    "storyboards generated for every scene",
    "animatic and AI dailies pass",
    "visual development and color script exist",
    "rig/motion/cinematography/simulation/lighting passes applied",
    "editorial sound music and dialogue performance passes applied",
    "synthetic audience panel passes",
    "accessibility and localization plans exist",
    "shot approval reaches FINAL",
    "render level reaches final",
    "production tracker and shot render plan exist",
    "asset and continuity memory updated",
    "A/B development receipt exists",
    "R&D technology is quarantined unless benchmark promoted",
    "analytics feedback maps to scene IDs when analytics are available",
    "studio department map verifies all implementations exist",
    "premium voice routing receipt exists when spoken dialogue exists",
    "voice candidate transcript fidelity passes",
    "character voice IDs remain locked by speaker",
    "winning premium voice take is injected into final render scene plan"
  ],
  "creative_contracts": {
    "character_bible": "control/character-bible-v1.json",
    "style_dna": "control/style-dna-v3.json",
    "creative_director": "control/creative-director-v3.json",
    "reference_decomposition": "control/reference-decomposition-contract.json",
    "blueprint_validator": "scripts/validate_creative_blueprint.py",
    "chat_drop_clone": "control/chat-drop-clone-contract.json",
    "reference_clone_compiler": "scripts/reference_clone_compiler.py",
    "reference_clone_validator": "scripts/validate_reference_clone.py",
    "generation_routing": "control/generation-routing.json",
    "character_board_lock": "control/character-board-lock-v1.json",
    "voice_lock": "control/voice-lock-v1.json",
    "concept_selection": "control/concept-selection-contract.json",
    "longform_clone": "control/longform-clone-contract.json",
    "ccsd_schema": "control/studio-scene-schema-v1.json",
    "studio_pipeline": "control/studio-pipeline-v1.json",
    "dailies": "control/dailies-contract-v1.json",
    "asset_catalog": "control/asset-catalog-v1.json",
    "render_levels": "control/render-levels-v1.json",
    "voice_performance": "control/voice-performance-v1.json",
    "analytics_learning": "control/analytics-learning-v1.json",
    "rd_quarantine": "control/rd-quarantine-v1.json",
    "studio_department_map": "control/studio-department-map-v1.json",
    "studio_department_verifier": "scripts/verify_studio_department_map.py",
    "premium_voice_routing": "control/voice-provider-routing-v2.json",
    "premium_voice_lock": "control/voice-lock-v1.json"
  }
}
