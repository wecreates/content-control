  "visual": {
    "native_canvas": "16:9",
    "reference_grammar": "white background, black stick figures, sparse props, large readable poses",
    "anti_overlap": true,
    "max_setting_sec": 60,
    "pattern_interrupt_max_sec": 4
  },
  "audio": {
    "narration_sfx_music_separate": true,
    "narrator_reads_sfx": false
  },
  "output_schema": {
    "long_form_meta": [
      "video_title_concepts",
      "total_target_run_time",
      "target_mid_roll_timestamps",
      "high_cpm_keyword_density"
    ],
    "episodes_timeline": [
      "act_number",
      "act_title",
      "timestamp_range",
      "scenes"
    ],
    "scene_fields": [
      "scene_timestamp",
      "voiceover_narration",
      "comedic_beat_mechanic",
      "sfx_audio_blueprint",
      "layering_coordinates"
    ]
  },
  "handoff_order": [
    "long_form_showrunner",
    "research_trend_agent",
    "lead_comedy_retention_engineer",
    "visual_layout_director",
    "hyper_critical_qa_director",
    "render_farm",
    "review_farm",
    "release_guard"
  ]
}
