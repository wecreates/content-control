{
  "schema_version": 1,
  "name": "Lead Executive Producer + Long-Form Showrunner",
  "publication_enabled": false,
  "minimum_runtime_sec": 510,
  "target_runtime_sec": 510,
  "act_max_without_structural_pivot_sec": 60,
  "acts": [
    {
      "number": 1,
      "title": "Financial Catastrophe Hook",
      "range": "0:00-1:00"
    },
    {
      "number": 2,
      "title": "Deconstructing System Mechanics",
      "range": "1:00-3:30"
    },
    {
      "number": 3,
      "title": "Multi-Card Comparison War",
      "range": "3:30-6:00"
    },
    {
      "number": 4,
      "title": "Hidden Loophole/Trap",
      "range": "6:00-7:30"
    },
    {
      "number": 5,
      "title": "Master Solution & Optimization Blueprint",
      "range": "7:30-8:30+"
    }
  ],
  "requested_midroll_markers": [
    "2:00",
    "4:30",
    "7:00"
  ],
  "note": "Markers are editorial break candidates only; actual YouTube ad serving is platform-controlled.",
  "factuality": {
    "current_primary_sources_required_for_card_terms": true,
    "comparison_claims_require_same_date_snapshot": true,
    "unsupported_loophole_claims_rejected": true
