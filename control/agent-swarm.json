{
  "schema_version": 2,
  "mode": "24x7_event_driven",
  "publication_enabled": false,
  "cco": {
    "id": "autonomous_cco",
    "goal": [
      "audience_retention",
      "RPM",
      "subscriber_growth"
    ],
    "first_video_publish": false
  },
  "agents": [
    {
      "id": "research_trend_agent",
      "parallelism": 2,
      "owns": [
        "viral competitor AV evidence",
        "credit-card trend research",
        "high-CPM keyword gaps",
        "issuer/regulator fact verification"
      ]
    },
    {
      "id": "script_retention_agent",
      "parallelism": 2,
      "owns": [
        "hook",
        "curiosity loops",
        "pattern interrupts <=5s",
        "simple language",
        "story payoff",
        "finance accuracy handoff"
      ]
    },
    {
      "id": "cinematic_director_lighting_engineer",
      "parallelism": 2,
      "owns": [
        "camera matrix",
        "2D light vectors",
        "parallax depth",
        "impact camera physics",
        "environmental audio beds",
        "foley sync"
      ]
    },
    {
      "id": "visual_layout_director",
      "parallelism": 2,
      "owns": [
        "native 9:16 and 16:9 staging",
        "anti-overlap bounding boxes",
        "white-background black-stick reference grammar",
        "prop scale",
        "shot cadence",
        "rendered-frame collision review"
      ]
    },
    {
      "id": "seo_publishing_agent",
      "parallelism": 1,
      "owns": [
        "title variants",
        "description",
        "chapters",
        "tags",
        "upload package"
      ],
      "publish_permission": false
    },
    {
      "id": "artifact_engineer",
      "parallelism": 2,
      "owns": [
        "artifact ingress",
        "hash verification",
        "provider upload cache"
      ]
    },
    {
      "id": "build_engineer",
      "parallelism": 2,
      "owns": [
        "dependencies",
        "worker image",
        "CI failures",
        "workflow repair"
      ]
    },
    {
      "id": "render_farm",
      "parallelism": 8,
      "owns": [
        "scene rendering",
        "patch rendering",
        "cache reuse"
      ]
    },
    {
      "id": "audio_farm",
      "parallelism": 4,
      "owns": [
        "voice",
        "SFX",
        "music",
        "mix",
        "alignment",
        "voice isolation"
      ]
    },
    {
      "id": "qa_farm",
      "parallelism": 8,
      "owns": [
        "media QA",
        "captions",
        "math",
        "sources",
        "motion",
        "safe zones",
        "anti-overlap"
      ]
    },
    {
      "id": "review_farm",
      "parallelism": 5,
      "owns": [
        "shard discovery review",
        "delta review",
        "complete final AV review"
      ]
    },
    {
      "id": "repair_router",
      "parallelism": 4,
      "owns": [
        "finding classification",
        "targeted repair plans",
        "predictive invalidation"
      ]
    },
    {
      "id": "assembler",
      "parallelism": 2,
      "owns": [
        "frame/sample patch assembly",
        "duration/sync verification"
      ]
    },
    {
      "id": "benchmark_reviewer",
      "parallelism": 2,
      "owns": [
        "supplied-Reel visual parity",
        "finance creator comparison",
        "animation comparison"
      ]
    },
    {
      "id": "bottleneck_resolver",
      "parallelism": 3,
      "owns": [
        "diagnose",
        "alternate route",
        "bounded retry",
        "failure memory"
      ]
    },
    {
      "id": "long_form_showrunner",
      "parallelism": 1,
      "owns": [
        "8+ minute episode architecture",
        "60-second act pivots",
        "mid-roll-safe story structure",
        "multi-card comparison acts",
        "trap/twist act",
        "solution and end-screen cliffhanger"
      ]
    },
    {
      "id": "anime_showrunner_metaphor_architect",
      "parallelism": 2,
      "owns": [
        "shonen battle metaphor",
        "named perk attacks",
        "fee/restriction debuffs",
        "anime impact choreography",
        "educational combat subtitles"
      ]
    },
    {
      "id": "autonomous_viral_content_engine",
      "parallelism": 2,
      "owns": [
        "combined viral scripting",
        "coordinate layout matrix",
        "dual-pass internal critique",
        "2-second visual interrupts",
        "acoustic punchlines",
        "SEO production blueprint"
      ]
    },
    {
      "id": "lead_comedy_retention_engineer",
      "parallelism": 2,
      "owns": [
        "visual irony",
        "relatable victim comedy",
        "micro-expression timing",
        "absurdist analogies",
        "2-second pattern interrupts",
        "comment engagement loops",
        "chapter cliffhangers"
      ]
    },
    {
      "id": "hyper_critical_qa_director",
      "parallelism": 2,
      "owns": [
        "Bored Scroller retention simulation",
        "Finance Skeptic credibility simulation",
        "timestamp friction log",
        "collision audit",
        "10X rewrite gate"
      ]
    },
    {
      "id": "release_guard",
      "parallelism": 1,
      "owns": [
        "exact hash lock",
        "user approval requirement",
        "publication lock"
      ]
    }
  ],
  "hard_rules": [
    "preserve all existing working agents",
    "publication remains disabled until explicit user approval",
    "first video must never auto-publish",
    "actual rendered media must be reviewed; source code or successful build is insufficient",
    "reference review requires actual frames plus actual audio/transcript evidence",
    "native 9:16 for Shorts and native 16:9 for long-form",
    "zero overlapping foreground bounding boxes unless explicitly marked intentional_contact",
    "white background and black stick-figure reference grammar is default production style",
    "voiceover text must never contain SFX or production directions",
    "SFX, music and narration are separate channels",
    "weak proof blocks full-episode expansion",
    "hyper-critical QA must approve the rewritten production JSON before production handoff",
    "comedy/retention script contract must pass before visual layout and hyper-critical QA",
    "VCE master blueprint must pass dual-pass Bored Scroller and Credit Card Nerd critique before downstream handoff",
    "long-form runtime must be at least 8 minutes 30 seconds before long-form handoff",
    "no long-form explanation or narrative setting may exceed 60 seconds without a structural pivot",
    "long-form episodes must target >=510 seconds and pivot setting/subplot/analogy at least every 60 seconds",
    "major finance comparisons use anime-battle metaphor unless a later explicit user direction overrides it",
    "every produced scene requires explicit camera behavior",
    "every produced scene requires explicit lighting vectors",
    "every produced scene requires environmental audio bed plus timed foley",
    "thumbnail-to-video promise parity is a release-gate requirement"
  ]
}
