    {
      "id": "clone_repair_director",
      "parallelism": 2,
      "owns": [
        "parity failure routing",
        "scene-only repair planning",
        "minimal rerender scope"
      ]
    }
  ],
  "hard_rules": [
    "preserve all existing working agents",
    "publication remains disabled until explicit user approval",
    "first video must never auto-publish",
    "actual rendered media must be reviewed; source code or successful build is insufficient",
    "reference review requires actual frames plus actual audio/transcript evidence",
    "native 9:16 for Shorts and native 16:9 for long-form",
    "zero overlapping foreground bounding boxes unless explicitly marked intentional_contact",
    "white background and black stick-figure reference grammar is default production style",
    "voiceover text must never contain SFX or production directions",
    "SFX, music and narration are separate channels",
    "weak proof blocks full-episode expansion",
    "hyper-critical QA must approve the rewritten production JSON before production handoff",
    "comedy/retention script contract must pass before visual layout and hyper-critical QA",
    "VCE master blueprint must pass dual-pass Bored Scroller and Credit Card Nerd critique before downstream handoff",
    "long-form runtime must be at least 8 minutes 30 seconds before long-form handoff",
    "no long-form explanation or narrative setting may exceed 60 seconds without a structural pivot",
    "long-form episodes must target >=510 seconds and pivot setting/subplot/analogy at least every 60 seconds",
    "major finance comparisons use anime-battle metaphor unless a later explicit user direction overrides it",
    "every produced scene requires explicit camera behavior",
    "every produced scene requires explicit lighting vectors",
    "every produced scene requires environmental audio bed plus timed foley",
    "thumbnail-to-video promise parity is a release-gate requirement",
    "thumbnail spectacle establishes a minimum visual promise that the video opening must satisfy; QA rejects thumbnail-video expectation mismatch",
    "all brand-fighter character heads use approved corporate logo assets instead of generic circle heads",
    "every production scene must specify camera behavior, lighting vectors, environmental audio bed, and timed foley",
    "all short-form production blueprints must pass scripts/validate_creative_blueprint.py before render",
    "recurring characters must use remotion/CharacterSystem.jsx or an explicitly versioned successor",
    "reference analysis extracts motion/comedy/camera grammar but never exact creator character identity or shot-for-shot staging",
    "every abstract finance claim must be physicalized into a visible action, prop transformation, or spatial consequence before render",
    "creative director must generate at least five materially different story engines before selecting a concept",
    "uploaded reference videos must be decomposed into durable reference.json before production",
    "reference clone builds must preserve measured timing/camera/motion grammar where useful",
    "reference clone builds must use Content Control locked characters rather than source creator characters",
    "generic text-to-video generation is not the primary clone path"
  ],
  "creative_contracts": {
    "character_bible": "control/character-bible-v1.json",
    "style_dna": "control/style-dna-v3.json",
    "creative_director": "control/creative-director-v3.json",
    "reference_decomposition": "control/reference-decomposition-contract.json",
    "blueprint_validator": "scripts/validate_creative_blueprint.py",
    "reusable_character_renderer": "remotion/CharacterSystem.jsx",
    "chat_drop_clone": "control/chat-drop-clone-contract.json",
    "reference_clone_compiler": "scripts/reference_clone_compiler.py",
    "reference_clone_validator": "scripts/validate_reference_clone.py",
    "generation_routing": "control/generation-routing.json",
    "character_board_lock": "control/character-board-lock-v1.json",
    "voice_lock": "control/voice-lock-v1.json",
    "concept_selection": "control/concept-selection-contract.json",
    "longform_clone": "control/longform-clone-contract.json",
    "reference_ingest": "scripts/ingest_reference_video.py",
    "reference_decomposer": "scripts/decompose_reference_video.py",
    "scene_plan_generator": "scripts/generate_clone_scene_plan.py",
    "style_memory": "scripts/style_memory.py",
    "reference_selector": "scripts/select_reference_candidate.py",
    "style_parity_qa": "scripts/reference_style_parity_qa.py",
    "character_identity_qa": "scripts/character_identity_qa.py",
