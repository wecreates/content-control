        "micro-expression timing",
        "absurdist analogies",
        "2-second pattern interrupts",
        "comment engagement loops",
        "chapter cliffhangers"
      ]
    },
    {
      "id": "hyper_critical_qa_director",
      "parallelism": 2,
      "owns": [
        "Bored Scroller retention simulation",
        "Finance Skeptic credibility simulation",
        "timestamp friction log",
        "collision audit",
        "10X rewrite gate"
      ]
    },
    {
      "id": "release_guard",
      "parallelism": 1,
      "owns": [
        "exact hash lock",
        "user approval requirement",
        "publication lock"
      ]
    },
    {
      "id": "character_continuity_director",
      "parallelism": 2,
      "owns": [
        "character bible enforcement",
        "silhouette continuity",
        "expression vocabulary",
        "signature pose reuse",
        "voice-role continuity",
        "rendered identity drift review"
      ]
    },
    {
      "id": "reference_decomposition_agent",
      "parallelism": 2,
      "owns": [
        "shot timeline measurement",
        "motion verb extraction",
        "camera verb extraction",
        "comedy engine extraction",
        "payoff timing",
        "transferable mechanics only"
      ]
    },
    {
      "id": "chat_drop_clone_director",
      "parallelism": 2,
      "owns": [
        "chat-upload reference ingestion",
        "reference shot decomposition",
        "clone blueprint compilation",
        "locked-character substitution",
        "timing/camera/motion fidelity",
        "originality boundary enforcement"
      ]
    },
    {
      "id": "style_memory_agent",
      "parallelism": 1,
      "owns": [
        "cross-reference grammar accumulation",
        "camera/motion pattern memory",
        "successful mechanic reuse"
