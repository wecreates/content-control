{
  "schema_version": 1,
  "provider": "render",
  "manifest": "render.yaml",
  "service_name": "content-control-render-worker",
  "runtime": "docker",
  "build_command": "npm ci --ignore-scripts --omit=dev",
  "start_command": "npm start",
  "health_check_path": "/health",
  "canonical_server": "server-lowmem.js",
  "canonical_media": "public-review/episode1-v10-free.mp4",
  "publication_enabled": false,
  "required_env": {
    "NODE_ENV": "production",
    "PUBLICATION_ENABLED": "false",
    "POD_SERVICE_ENABLED": "false",
    "POD_PRODUCTION_ENABLED": "false",
    "POD_PUBLICATION_ENABLED": "false"
  },
  "public_base_url": "https://content-control-render-worker.onrender.com",
  "live_probe_required": true,
  "dockerfile_path": "./Dockerfile",
  "docker_context": "."
}
